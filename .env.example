# 站点信息
VITE_SITE_NAME = "清沐的个人博客" # 名称（加载页 / 浏览器标题 / PWA）
VITE_SITE_AUTHOR = "清沐" # 底栏版权作者
VITE_SITE_KEYWORDS = "清沐,个人博客,VOCALOID,初音未来,Project SEKAI" # 关键词
VITE_SITE_DES = "一个喜欢初音未来与 VOCALOID 的个人小站" # 站点简介
VITE_SITE_URL = "qingmu39.top" # 站点地址（Logo 大标题显示；若未注册该域名则仅作展示，底栏链接暂不可点）
VITE_SITE_LOGO = "images/icon/favicon.ico" # 站点主图标
VITE_SITE_MAIN_LOGO = "images/icon/logo.jpg" # 主页圆形头像（public/images/icon/logo.jpg）
VITE_SITE_APPLE_LOGO = "images/icon/apple-touch-icon.png" # Apple 端图标

# 简介文本（简介卡片两行字；点击卡片可在两组间切换）
VITE_DESC_HELLO = "Welcome ~"
VITE_DESC_TEXT = "这里是一个喜欢初音未来与 VOCALOID 的小站，正在努力搭建中"
VITE_DESC_HELLO_OTHER = "Oops !"
VITE_DESC_TEXT_OTHER = "盒子里有时光胶囊和一些小东西，再点一次即可关闭"

# 天气 Key
## 留空则自动调用免费备用 API（教书先生）；推荐自行申请高德 Web 服务 Key
## 并将 VITE_WEATHER_KEY 作为仓库 Secret 配置（避免密钥入库）
VITE_WEATHER_KEY = ""

# 建站日期
## 填写 YYYY-MM-DD（底栏年份区间与时光胶囊“建站统计”使用）；不需要则留空
VITE_SITE_START = ""

# ICP 备案号（国内服务器/域名备案后填写，不需要则留空）
VITE_SITE_ICP = ""

# 歌曲 API 地址（网易云歌单：清沐の歌单 id=13757047519）
## 该公共服务可能超量或失效，失效时可自建 Meting-API：https://github.com/xizeyoupan/Meting-API
VITE_SONG_API = "https://api-meting.imsyy.top/api"
# 歌曲服务器 ( netease-网易云, tencent-qq音乐 )
VITE_SONG_SERVER = "netease"
# 播放类型 ( song-歌曲, playlist-播放列表, album-专辑, search-搜索, artist-艺术家 )
VITE_SONG_TYPE = "playlist"
# 播放 ID ( 若无需播放器，请设为空即可 )
VITE_SONG_ID = "13757047519"
